{
  "lpTagPatternA": {
    "memoryBank": 1,               // 示例：内存区域，可取值 "EPC"、"TID"、"USER" 等
    "bitOffset": 32,                   // 位偏移值
    "pTagPattern": "A1B2C3",           // 标签模式数据，示例采用十六进制字符串表示
    "tagPatternBitCount": 24,          // 标签模式数据的有效位数
    "pTagMask": "FF00FF",              // 标签掩码数据，示例采用十六进制字符串表示
    "tagMaskBitCount": 24,             // 标签掩码数据的有效位数
  },
  "lpTagPatternB": {
    "memoryBank": 2,
    "bitOffset": 16,
    "pTagPattern": "0F0E0D",
    "tagPatternBitCount": 24,
    "pTagMask": "00FF00",
    "tagMaskBitCount": 24,
  },
  "matchPattern": 1                 // 根据 matchPattern 条件，通常为一个整型数值
}
