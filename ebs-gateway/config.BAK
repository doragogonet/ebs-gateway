#include "config.h"
#include "logger.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_DEVICES 10
static const  DeviceInterface* drivers[MAX_DRIVERS] = {0};
static int driver_count = 0;


// 提取 protocol_version 的数值部分
char* extract_numeric_version(const char* version) {
    static char clean_version[32];  // 仅适用于短字符串
    int j = 0;
    for (int i = 0; version[i] != '\0' && j < sizeof(clean_version) - 1; i++) {
        if ((version[i] >= '0' && version[i] <= '9') || version[i] == '.') {
            clean_version[j++] = version[i];
        }
    }
    clean_version[j] = '\0';
    return clean_version;
}

// 解析 JSON 取出所有设备驱动
int parse_json_and_fill_device(const char* filename, char** driver, int* device_count) {
    FILE* file;
    errno_t err = fopen_s(&file, filename, "r");
    if (err != 0 || !file) {
        perror("Error: Unable to open JSON file");
        return -1;
    }

    // 读取 JSON 文件内容
    fseek(file, 0, SEEK_END);
    long length = ftell(file);
    fseek(file, 0, SEEK_SET);
    char* data = (char*)malloc(length + 1);
    if (!data) {
        perror("Error: Memory allocation failed");
        fclose(file);
        return -1;
    }
    fread(data, 1, length, file);
    fclose(file);
    data[length] = '\0';

    // 解析 JSON
    cJSON* json = cJSON_Parse(data);
    free(data);
    if (!json) {
        printf("Error: JSON parsing failed: %s\n", cJSON_GetErrorPtr());
        return -1;
    }

    cJSON* devices_array = cJSON_GetObjectItem(json, "devices");
    if (!cJSON_IsArray(devices_array)) {
        printf("Error: The 'devices' field is not an array.\n");
        cJSON_Delete(json);
        return -1;
    }

    *device_count = cJSON_GetArraySize(devices_array);
    *driver = malloc((*device_count) * sizeof(char));
    if (!(*driver)) {
        perror("Error: Memory allocation failed");
        cJSON_Delete(json);
        return -1;
    }

    for (int i = 0; i < *device_count; i++) {
        cJSON* device_json = cJSON_GetArrayItem(devices_array, i);
        cJSON* load_driver = cJSON_GetObjectItem(device_json, "load_driver");
        (*driver)[i] = load_driver ? _strdup(load_driver->valuestring) : _strdup("Unknown");
    
    }

    cJSON_Delete(json);
    return 0;
}


// 用户指定设备
int discover(const char* model_name, DeviceInterface *dev) {
    for (int i = 0; i < driver_count; i++) {
        if (strcmp(drivers[i]->model_name, model_name) == 0) {
            dev = drivers[i];
            return 0;
        }
    }
    return -1;
}



//设备驱动建锁
int device_Lock(DeviceInterface* driver) {
    
    // 初始化临界区（轻量级用户模式锁）
    // 保证同一时间只有一个线程访问DeviceInterface
    InitializeCriticalSection(&driver->lock);
    
    // 创建互斥体（内核对象，跨进程可用）
    // 确保不同进程之间也不能同时访问DeviceInterface
    driver->hMutex = CreateMutex(NULL, FALSE, NULL);
    if (driver->hMutex == NULL) {
        return GetLastError();
    } 
    status = 1; // 设备初始化成功，状态置 1
    printf("Device initialized successfully.\n");
    return 0;
}

// 注册设备驱动
void rw_register_driver(const DeviceInterface* driver) {
    if (driver_count < MAX_DRIVERS) {
        drivers[driver_count++] = driver;
        rw_log(LOG_LEVEL_INFO, "Driver registered: %s %s", driver->manufacturer, driver->model);
    }else{
		rw_log(LOG_LEVEL_ERROR, "Driver registered: %s %s", driver->manufacturer, driver->model);
	}
}

// 动态加载驱动
int rw_load_driver(const char* driver_path) {
    HMODULE handle = LoadLibraryA(driver_path);
    if (!handle) {
        rw_log(LOG_LEVEL_ERROR, "Failed to load driver: %d", GetLastError());
        return -1;
    }

	// 把 void* 转换成 返回 const DeviceInterface* 的函数指针
    DeviceInterface* (*zebra_interface)(void) = (const DeviceInterface* (*)(void))GetProcAddress(handle, "zebra_interface");
    if (!zebra_interface) {
        rw_log(LOG_LEVEL_ERROR, "Invalid driver: %s", driver_path);
        FreeLibrary(handle);
        return -1;
    }
    
    const DeviceInterface* driver = zebra_interface();
    
    driver->hModule  = handle;
    // 注册设备驱动
    rw_register_driver(driver);
    
    return 0;
}



// 动态卸载驱动
int rw_unload_driver(const char* driver_name) {
    for (int i = 0; i < driver_count; i++) {
        if (strcmp(drivers[i]->dev->model_name, driver_name) == 0) {
			if(drivers[i]->hModule){
				FreeLibrary(drivers[i]->hModule);
			}
            ////设备驱动关闭时释放资源
            drivers[i] = NULL;
            rw_log(LOG_LEVEL_INFO, "Driver unloaded: %s", driver_name);
            return 0;
        }
    }
    return -1;
}

// 处理入口 
int device_open(const char* config_file) {

    char* driver = NULL;
    
    int device_count = 0;

    if (parse_json_and_fill_device(config_file, &driver, &device_count) == 0) {
        for (int i = 0; i < device_count; i++) {
            printf("  Load Driver: %s\n", driver[i]);
	    	// 调入设备驱动DLL
	    	rw_load_driver(driver[i]);
        }       
        //释放数据
        free(driver);
    }

    return 0;
}


//设备关闭
int device_close(DeviceInterface* dev) {
    // 销毁临界区
    DeleteCriticalSection(&dev->lock);
    
    // 关闭互斥体句柄
    if (dev->hMutex) {
        CloseHandle(dev->hMutex);
    }
    dev->status = 0;  // **标记设备已关闭**
    printf("Device resources released.\n");
    
    
    return 0;
}




/********************
 预定使用方法
 
 系统启动操作内容
   ,device_open  读出外部设备驱动
      |
      |-----rw_load_driver 加载设备驱动DL
      |
      |-----rw_register_driver(driver);// 注册设备驱动＝＞drivers[MAX_DRIVERS] 
      
      
 系统退出前 需要卸载所以驱动
      
      
用户操作内容
    
      discover 用户指定设备
        |
      device_Lock 设备驱动上锁
        |
      接续，读写，盘点等操作
        |
      device_close 设备驱动解锁


